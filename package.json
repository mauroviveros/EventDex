{
  "name": "eventdex",
  "description": "Event management system",
  "author": {
    "name": "Mauro Daniel Viveros (TRY Ubbe)",
    "email": "maurod.viveros@gmail.com",
    "url": "https://github.com/mauroviveros"
  },
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mauroviveros/eventdex.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:link": "supabase link",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff --linked",
    "db:push": "supabase db push",
    "db:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/permissions.sql",
    "db:pull": "supabase db pull",
    "db:types": "mkdir -p packages/db/src && supabase gen types typescript --linked --schema public > packages/db/src/database.types.ts"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "supabase": "^2.114.0",
    "turbo": "^2.10.8"
  }
}
