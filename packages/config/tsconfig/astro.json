{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "react"
  },
  "include": ["${configDir}/.astro/types.d.ts", "${configDir}/**/*"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
