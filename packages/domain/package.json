{
  "name": "@eventdex/domain",
  "description": "Pure product rules: no I/O, no framework",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-types": "tsc --noEmit",
