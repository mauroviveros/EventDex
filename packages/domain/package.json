    "test:watch": "vitest"
  },
  "dependencies": {
    "@eventdex/db": "workspace:*"
  },
  "devDependencies": {
    "@eventdex/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
