# Copiá este archivo a `.env` y completá los valores.
# El esquema que los valida está en `astro.config.mjs` (env.schema).

# Proyecto Supabase v2. Dashboard → Project Settings → API.
# La publishable key respeta RLS: es la que va en el navegador.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional. Fuerza el hostname en desarrollo para no tocar /etc/hosts.
# El seed registra `localhost:4321` como dominio primario de la organización
# de prueba, así que con el puerto por defecto no hace falta setearlo.
PUBLIC_DEV_HOST=localhost:4321

# Opcional. URL del dashboard de organizadores, para el link del menú.
PUBLIC_ADMIN_URL=http://localhost:3000
