---
import { eventPhase, eventRange, formatScheduleLabel } from "@eventdex/domain";
import Countdown from "@/islands/Countdown";
import Layout from "@/layouts/Layout.astro";
import { getEventSpots } from "@/lib/spots";

const { supabase, eventId } = Astro.locals;

const [eventResult, spots] = await Promise.all([
  eventId
    ? supabase
        .from("events")
        .select(`
          id, title, edition_label, summary, timezone,
          schedules:event_schedules(label, starts_at, ends_at),
          venue:venues(name, city)
        `)
        .eq("id", eventId)
        .single()
    : null,
  eventId ? getEventSpots(supabase, eventId) : [],
]);

const event = eventResult?.data ?? null;
const schedules = event?.schedules ?? [];
const phase = eventPhase(schedules);
const range = eventRange(schedules);
const now = Date.now();

const PHASE_LABEL = {
  upcoming: "Próximamente",
  live: "En curso",
  finished: "Finalizado",
} as const;

const TYPE_LABEL = {
  stand: "Stand",
  attraction: "Atracción",
  sponsor: "Sponsor",
  activity: "Actividad",
} as const;
---

<Layout
  title={event?.title ?? "Eventdex"}
  description={event?.summary ?? undefined}
>
  {
      event ? (
        <article>
          {phase && <p class="text-sm uppercase tracking-wide">{PHASE_LABEL[phase]}</p>}

          <h1 class="text-3xl font-semibold text-brand">
            {event.title}
            {event.edition_label && <span> · {event.edition_label}</span>}
          </h1>

          {event.summary && <p class="mt-2">{event.summary}</p>}

          {event.venue && (
            <p class="mt-1 text-sm">
              {event.venue.name}
              {event.venue.city && <span> · {event.venue.city}</span>}
            </p>
          )}

          <ul class="mt-6 space-y-1">
            {schedules.map((schedule) => (
              <li>
                {schedule.label && <strong>{schedule.label}: </strong>}
                {formatScheduleLabel(schedule, event.timezone)}
              </li>
            ))}
          </ul>

          {phase === "upcoming" && range && (
            <Countdown target={range.start} now={now} client:idle />
          )}

          {spots.length > 0 && (
            <section class="mt-10">
              <h2 class="text-xl font-semibold">
                Coleccioná las {spots.length} medallas
              </h2>

              <ul class="mt-4 grid gap-4 sm:grid-cols-2">
                {spots.map((spot) => (
                  <li class="rounded-lg border p-4">
                    <p class="text-xs uppercase tracking-wide">
                      {TYPE_LABEL[spot.type]} · {spot.code}
                    </p>
                    <h3 class="mt-1 font-medium">{spot.name}</h3>
                    {spot.description && <p class="mt-1 text-sm">{spot.description}</p>}
                    {spot.booth && <p class="mt-2 text-xs">{spot.booth}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </article>
      ) : (
        <p>Todavía no hay eventos publicados.</p>
      )
    }
</Layout>
