---
import { collectionProgress } from "@eventdex/domain";
import Account from "@/components/Account.astro";
import Layout from "@/layouts/Layout.astro";
import { getClaimedSpotIds } from "@/lib/claims";
import { getVisitor } from "@/lib/session";
import { getEventSpots } from "@/lib/spots";

const { supabase, eventId } = Astro.locals;
const visitor = await getVisitor(supabase);

const [spots, claimedIds] = await Promise.all([
  eventId ? getEventSpots(supabase, eventId) : [],
  eventId && visitor?.id ? getClaimedSpotIds(supabase, eventId, visitor.id) : [],
]);

const claimed = new Set(claimedIds);
const progress = collectionProgress(
  claimedIds,
  spots.map((spot) => spot.id)
);
---

<Layout title="Mis medallas" noindex>
  {visitor ? (
    <div class="space-y-3">
      <h1 class="text-2xl font-semibold">Mis medallas</h1>
      <p>Entrá para ver tu colección.</p>
      <Account />
    </div>
  ) : spots.length === 0 ? (
    <p>Todavía no hay un evento en marcha.</p>
  ) : (
    <article class="space-y-6">
      <header class="space-y-2">
        <h1 class="text-2xl font-semibold">
          {progress.claimed} de {progress.total} medallas
        </h1>

        {/*
          `aria-hidden` y no `role="progressbar"`: el `<h1>` de arriba ya dice
          "3 de 5 medallas", así que la barra es una representación visual de
          algo que el lector de pantalla ya anunció. Darle semántica de
          progressbar haría que lo diga dos veces.

          `bg-muted` y no `bg-black/10`: los tokens contemplan modo oscuro, y
          negro sobre negro desaparece.
        */}
        <div class="h-2 w-full overflow-hidden rounded bg-muted" aria-hidden="true">
          <div class="h-full bg-brand" style={`width: ${progress.percent}%`}></div>
        </div>

        <p class="text-sm">
          {progress.isComplete
            ? "🎉 ¡Completaste la colección!"
            : `Te ${progress.remaining === 1 ? "falta" : "faltan"} ${progress.remaining}.`
          }
        </p>
      </header>

      <ul class="grid gap-3 sm:grid-cols-2">
       {spots.map((spot) => {
        const got = claimed.has(spot.id);

        // El estado pendiente se baja de énfasis con tokens y no con
        // `opacity-40`: la opacidad aplastaba el contraste de ~17:1 a ~2:1, muy
        // por debajo del 4.5:1 que pide WCAG AA. Y no es texto decorativo
        // —dice qué stand te falta— así que tiene que leerse.
        //
        // `muted-foreground` sobre `muted` queda alrededor de 5:1: pasa AA y
        // sigue viéndose secundario.
        return (
          <li
            class:list={[
              "rounded-lg border p-4",
              got ? "" : "bg-muted text-muted-foreground",
            ]}
          >
            <p class="text-xs uppercase tracking-wide">
              {got ? "Conseguida" : "Pendiente"} · {spot.code}
            </p>

            <h2 class="mt-1 font-medium">{got ? spot.name : "???"}</h2>
            {got && spot.booth && <p class="mt-1 text-xs">{spot.booth}</p>}
          </li>
        )
       })}
      </ul>
    </article>
  )}
</Layout>
