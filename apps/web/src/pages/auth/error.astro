---
import Account from "@/components/Account.astro";
import Layout from "@/layouts/Layout.astro";

/**
 * Adónde caen los fallos de `/auth/signin` y `/auth/callback`.
 *
 * El `reason` llega por query string, o sea que es texto del cliente. NUNCA se
 * renderiza crudo: se usa solo como clave de este diccionario. Mostrarlo tal
 * cual dejaría que `?reason=Tu cuenta fue bloqueada, llamá al 0800...` se
 * imprima como si fuera un mensaje nuestro.
 */
const REASONS: Record<string, string> = {
  provider: "Ese proveedor de ingreso no está habilitado.",
  oauth: "No pudimos contactar al proveedor. Probá de nuevo en un momento.",
  "missing-code": "El proveedor no devolvió un código de autorización.",
  exchange: "No pudimos intercambiar el código por un token de acceso.",
  access_denied: "El proveedor denegó el acceso.",
  server_error: "Ocurrió un error en el servidor. Probá de nuevo en un momento.",
};

const raw = Astro.url.searchParams.get("reason");
const message = (raw && REASONS[raw]) ?? "No pudimos completar el ingreso.";
---

<Layout
  title="No pudimos completar el ingreso"
  description={message}
  noindex
>
  <div class="space-y-2">
    <h1 class="text-2xl font-semibold">No pudimos completar el ingreso</h1>
    <p class="text-sm">{message}</p>

    <!--
      `<Account />` ya muestra los dos botones cuando no hay sesión, así que
      sirve de reintento sin duplicar el markup del login. Si la sesión sí quedó
      creada —el error fue después del canje— muestra el nombre, que también es
      la respuesta correcta.

      `next="/"` y no el default: volver acá después de un login exitoso sería
      mostrarle al visitante un error que ya no existe.
    -->
    <Account next="/" />

    <p class="text-sm">
      <a href="/" class="underline">Volver al inicio</a>
    </p>
  </div>
</Layout>
