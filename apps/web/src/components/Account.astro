---
import { getVisitor } from "@/lib/session";

/**
 * Estado de sesión del visitante: los dos botones de login, o quién sos.
 *
 * Se usa `getClaims()` y no `getUser()` porque verifica el JWT localmente con
 * las claves asimétricas del proyecto, sin ir a la red. `getUser()` pega al
 * servidor de Auth en CADA render, y esto va en el layout de una página
 * pública que tiene que cargar rápido.
 */
const { supabase } = Astro.locals;
const visitor = await getVisitor(supabase);

interface Props {
  next?: string;
}
const { next = Astro.url.pathname + Astro.url.search } = Astro.props;
---
{visitor ? (
  <div class="flex items-center gap-3">
    <a
      href="/perfil"
      class="flex items-center gap-2 text-sm hover:underline"
      aria-current={Astro.url.pathname === "/perfil" ? "page" : undefined}
    >
      {visitor.avatarUrl && (
        <img src={visitor.avatarUrl} alt="" width="32" height="32" class="rounded-full" />
      )}
      <span class="text-sm">{visitor.displayName}</span>
    </a>

    <form method="POST" action="/auth/signout">
      <input type="hidden" name="next" value={next} />
      {/*
        `min-h-6` = 24px, el mínimo de WCAG 2.2 AA (2.5.8) para un objetivo
        táctil. Sin padding el link quedaba en ~20px, y esto se usa en un
        celular caminando por un predio.
      */}
      <button type="submit" class="min-h-6 px-2 text-sm underline">
        Salir
      </button>
    </form>
  </div>
): (
  <div class="flex items-center gap-2">
    <form method="POST" action="/auth/signin" class="flex items-center gap-2">
      <input type="hidden" name="next" value={next} />

      <button
        type="submit"
        name="provider"
        value="google"
        class="rounded border px-3 py-1.5 text-sm"
      >
        Entrar con Google
      </button>

      <button
        type="submit"
        name="provider"
        value="github"
        class="rounded border px-3 py-1.5 text-sm"
      >
        Entrar con GitHub
      </button>
    </form>
  </div>
)}
