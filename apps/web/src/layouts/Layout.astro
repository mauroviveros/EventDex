---
import Account from "@/components/Account.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  /** Para la meta description y el OG. Opcional: no toda página tiene una. */
  description?: string;
  /** Fuera del índice de buscadores. Para pantallas que no son contenido. */
  noindex?: boolean;
}

const { organizationName } = Astro.locals;
const { title, description, noindex = false } = Astro.props;

// El mismo string para el <title> y el og:title: son la misma cosa, y tenerlos
// distintos es la forma más fácil de que uno quede viejo.
const fullTitle = `${title} · ${organizationName}`;
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />

  <link rel="icon" href="/favicon.ico" />
  <link rel="canonical" href={Astro.url.href} />

  <title>{fullTitle}</title>

  {noindex && <meta name="robots" content="noindex" />}
  {description && <meta name="description" content={description} />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={organizationName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:url" content={Astro.url.href} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:locale" content="es_AR" />

  <meta name="twitter:card" content="summary" />
</head>
<body class="mx-auto max-w-2xl p-8">
  <header class="flex items-center justify-between gap-4 border-b pb-4">
    <a href="/" class="font-semibold">Eventdex</a>
    <Account />
  </header>

  <main class="space-y-8 pt-8">
    <slot />
  </main>
</body>
</html>
