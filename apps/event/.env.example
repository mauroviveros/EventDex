NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Organización dueña del sitio. Qué evento se muestra lo decide la app según el
# calendario (en curso > próximo > último terminado): no hace falta configurarlo.
EVENTDEX_ORGANIZATION_ID=

# Opcional: URL del dashboard de organizadores. Sin esto, el menú no ofrece el
# acceso y el resto de la app funciona igual.
NEXT_PUBLIC_DASHBOARD_URL=

# Opcional: URL pública del sitio (metadata/sitemap/robots). En Vercel se deduce
# del deployment; setear solo para un dominio custom.
NEXT_PUBLIC_SITE_URL=
